# Root Compose environment (copy to .env)
# Generate APP_KEY with: docker compose run --rm api php artisan key:generate --show
# or locally: php apps/api/artisan key:generate --show
#
# Password values below are LOCAL DEV ONLY — never reuse in shared or production hosts.
# Compose requires these secrets (no inlined password defaults in compose.yaml).

APP_KEY=
HTTP_PORT=18080
LOCALFAKEMAIL_UI_PORT=18025
SONAR_PORT=9000

DB_DATABASE=aact
DB_USERNAME=aact
DB_PASSWORD=aact_secret
DB_ROOT_PASSWORD=root_secret

# Redis (Compose enables --requirepass; injected into API as REDIS_PASSWORD)
REDIS_PASSWORD=aact_redis_secret

# Mail — default is log (fast setup, no extra images).
# For localfakemail inbox UI (builds Node SMTP+web from a pinned GitHub commit):
#   COMPOSE_PROFILES=mail
#   MAIL_MAILER=smtp
MAIL_MAILER=log
MAIL_HOST=localfakemail-smtp
MAIL_PORT=1025
MAIL_USERNAME=lfm_aact_localdev
MAIL_PASSWORD=aact_dev_mail_secret
LOCALFAKEMAIL_DB_PASSWORD=localfakemail
EMAIL_RETENTION_LIMIT=500

SONAR_DB_PASSWORD=sonar

# Local SonarScanner (make sonar-scan). Never commit a real token.
# Create at http://localhost:9000 → User → My Account → Security
SONAR_TOKEN=

# Optional Compose profiles (comma-separated):
#   mail       — localfakemail SMTP + web UI (http://localhost:18025)
#   antivirus  — ClamAV
#   sonar      — SonarQube
# Example: COMPOSE_PROFILES=mail
COMPOSE_PROFILES=

# Private documents (required for portal uploads — application-encrypted blobs).
# Generate: php -r "echo 'base64:'.base64_encode(random_bytes(32)), PHP_EOL;"
# Staging/prod S3 overrides live in local .env.staging (never commit real bucket/keys).
PRIVATE_DOCUMENTS_DRIVER=local
PRIVATE_DOCUMENTS_PREFIX=referrers-docs
# Local/CI example only — generate a unique key for real environments.
AACT_PRIVATE_DOCUMENT_ENCRYPTION_KEY=base64:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
