# Root Compose environment (copy to .env)
# Generate APP_KEY with: docker compose run --rm api php artisan key:generate --show
# or locally: php apps/api/artisan key:generate --show

APP_KEY=
HTTP_PORT=18080
LOCALFAKEMAIL_UI_PORT=18025
SONAR_PORT=9000

DB_DATABASE=aact
DB_USERNAME=aact
DB_PASSWORD=aact_secret
DB_ROOT_PASSWORD=root_secret

# localfakemail — Compose builds from github.com/neverundo/localfakemail#main
# Dev SMTP auth (seeded automatically by localfakemail-seed)
MAIL_USERNAME=lfm_aact_localdev
MAIL_PASSWORD=aact_dev_mail_secret
EMAIL_RETENTION_LIMIT=500

SONAR_DB_PASSWORD=sonar

# Local SonarScanner (make sonar-scan). Never commit a real token.
# Create at http://localhost:9000 → User → My Account → Security
SONAR_TOKEN=

# Optional Compose profiles:
#   docker compose --profile antivirus up -d
#   docker compose --profile sonar up -d
COMPOSE_PROFILES=
